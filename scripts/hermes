#!/usr/bin/env bash
# ============================================================
#  HERMES WORKSPACE COMMAND — C:\hermes
#  Usage:
#    hermes                → show workspace banner + status
#    hermes status         → workspace status
#    hermes tree           → directory tree
#    hermes info           → system info
#    hermes diag           → full system health report
#    hermes watch          → live system monitor (every 5s)
#    hermes report         → generate today's auto-report
#    hermes refresh        → refresh dashboard live data
#    hermes projects       → list projects
#    hermes backup         → zip backup
#    hermes widget         → open SNS status widget
#    hermes dash           → open dashboard preview
#    hermes help           → this help
# ============================================================

WS="C:/hermes"
PY="python"

banner() {
    echo ""
    echo "  ⚡  H E R M E S   W O R K S P A C E  ⚡"
    echo "  ────────────────────────────────────────"
    echo "  Location : $WS"
    echo "  Model    : hermes-agent  ·  nous research"
    echo ""
}

# Real-time banner stats
banner_stats() {
    $PY "$WS/tools/system_diagnostics.py" --json 2>/dev/null | python -c "
import sys, json
try:
    d = json.load(sys.stdin)
    cpu = str(d.get('cpu_percent'))+'%' if d.get('cpu_percent') is not None else 'n/a'
    m = d.get('memory', {})
    mem = str(m.get('percent'))+'%' if m.get('percent') is not None else 'n/a'
    disk = d.get('disk', {})
    dsk = str(disk.get('percent'))+'%' if disk.get('percent') is not None else 'n/a'
    ph = d.get('hostname','?')
    nprocs = len(d.get('top_processes', []))
    print(f'  Host     : {ph}')
    print(f'  CPU      : {cpu}   Memory: {mem}   Disk: {dsk}')
    print(f'  Procs    : top {nprocs}')
except Exception:
    pass
"
}

cmd="${1:-}"
case "$cmd" in
    status)  banner; $PY "$WS/tools/hermes_toolkit.py" status ;;
    tree)    banner; $PY "$WS/tools/hermes_toolkit.py" tree ;;
    info)    banner; $PY "$WS/tools/hermes_toolkit.py" info ;;
    diag)    banner; $PY "$WS/tools/system_diagnostics.py" ;;
    watch)   banner; echo "  (Ctrl+C to stop live monitor)"; echo ""; $PY "$WS/tools/system_diagnostics.py" --watch 5 ;;
    report)  $PY "$WS/tools/auto_report.py" --print ;;
    refresh) $PY "$WS/tools/hermes_toolkit.py" refresh ;;
    projects) banner; $PY "$WS/tools/project_tracker.py" list ;;
    backup)  banner; $PY "$WS/tools/hermes_toolkit.py" backup ;;
    widget)  start "$WS/projects/sns_showcase/status_widget.html" ;;
    dash)    start "$WS/dashboard/index.html" ;;
    diary)   banner; $PY "$WS/tools/diary.py" list ;;
    diary-write) shift; $PY "$WS/tools/diary.py" write "$@" ;;
    fsize)   banner; $PY "$WS/tools/file_utils.py" size "$WS" ;;
    net)     banner; shift; $PY "$WS/tools/net_utils.py" "$@" ;;
    md2html) banner; shift; $PY "$WS/tools/md2html.py" "$@" ;;
    treemap) banner; $PY "$WS/tools/treemap.py" "$WS" ; start "$WS/projects/treemap/index.html" ;;
    badge)   banner; $PY "$WS/tools/badge.py" --card; $PY "$WS/tools/badge.py" --out "$WS/projects/badge/flat.svg" ;;
    commit)  banner; $PY "$WS/tools/autocommit.py" ;;
    search)  banner; shift; $PY "$WS/tools/search_notes.py" "$@" ;;
    wc)      banner; $PY "$WS/tools/wordcloud.py"; start "$WS/projects/wordcloud/wc.png" ;;
    timeline) banner; $PY "$WS/tools/timeline.py"; start "$WS/projects/timeline/index.html" ;;
    snake)   start "$WS/projects/snake/index.html" ;;
    typing)  start "$WS/projects/typing/index.html" ;;
    gallery) start "$WS/projects/showcase/index.html" ;;
    breakout) start "$WS/projects/breakout/index.html" ;;
    pomodoro) start "$WS/projects/pomodoro/index.html" ;;
    devcalc)  start "$WS/projects/devcalc/index.html" ;;
    regex)    start "$WS/projects/regex/index.html" ;;
    tokyo)    start "$WS/projects/tokyo/index.html" ;;
    api-status) curl -s http://127.0.0.1:8765/api/status | python -m json.tool 2>/dev/null || echo "서버 꺼짐 — 'hermes api'로 시작" ;;
    api)      banner; (cd "$WS" && $PY tools/api_server.py --port "${PORT:-8765}") &
echo "API 서버 기동 중... http://127.0.0.1:8765/"
sleep 2; curl -s http://127.0.0.1:8765/api/health || echo "  (curl로 상태 확인)" ;;
    fortune) start "$WS/projects/fortune/index.html" ;;
    cc)      start "$WS/projects/command_center/index.html" ;; 
    os)      start "$WS/projects/hermes_os/index.html" ;;
    sentiment) $PY "$WS/tools/sentiment.py" "${@:2}" ;;
    poster) banner; $PY "$WS/tools/poster.py" --theme "${2:-dark}"; start "$WS/projects/poster/poster_${2:-dark}.png" ;;
    summary) $PY "$WS/tools/summary.py" ;;
    smoke) $PY "$WS/tools/smoke.py" ;;
    check) $PY "$WS/tools/validate_widgets.py" ;;
    oscheck) $PY "$WS/tools/verify_os_catalog.py" ;;
    gauges) start "$WS/projects/gauges/index.html" ;;
    analytics) banner; $PY "$WS/tools/analytics.py"; start "$WS/projects/analytics/index.html" ;;
    g2048)  start "$WS/projects/g2048/index.html" ;;
    ttt)    start "$WS/projects/gttt/index.html" ;;
    games)  start "$WS/projects/gamehub/index.html" ;;
    mem)    start "$WS/projects/gmem/index.html" ;;
    reflex) start "$WS/projects/greact/index.html" ;;
    rhythm)  start "$WS/projects/rhythm/index.html" ;;
    cube)   start "$WS/projects/landing/index.html" ;;
    deck)   start "$WS/projects/deck/index.html" ;;
    daily)  start "$WS/projects/daily/index.html" ;;
    kanban) start "$WS/projects/kanban/index.html" ;;
    timer)  start "$WS/projects/timer/index.html" ;;
    eng3d)  start "$WS/projects/engine3d/index.html" ;;
    drum)   start "$WS/projects/drum/index.html" ;;
    synth)  start "$WS/projects/synth/index.html" ;;
    viz)    start "$WS/projects/viz/index.html" ;;
    lang)   start "$WS/projects/lang/index.html" ;;
    ray)    start "$WS/projects/ray/index.html" ;;
    solar)  start "$WS/projects/solar/index.html" ;;
    life)   start "$WS/projects/life/index.html" ;;
    portal) start "$WS/projects/portal/index.html" ;;
    fra)    start "$WS/projects/fra/index.html" ;;
    nn)     start "$WS/projects/nn/index.html" ;;
    grav)   start "$WS/projects/grav/index.html" ;;
    kal)    start "$WS/projects/kal/index.html" ;;
    tarot)  start "$WS/projects/tarot/index.html" ;;
    qlearn) start "$WS/projects/qlearn/index.html" ;;
    ga)     start "$WS/projects/ga/index.html" ;;
    astar)  start "$WS/projects/astar/index.html" ;;
    ca)     start "$WS/projects/ca/index.html" ;;
    lor)    start "$WS/projects/lor/index.html" ;;
    wave)   start "$WS/projects/wave/index.html" ;;
    simon)  start "$WS/projects/simon/index.html" ;;
    mine)   start "$WS/projects/mine/index.html" ;;
    tet)    start "$WS/projects/tet/index.html" ;;
    othello) start "$WS/projects/othello/index.html" ;;
    chess)  start "$WS/projects/chess/index.html" ;;
    conv)   start "$WS/projects/conv/index.html" ;;
    sec)    start "$WS/projects/sec/index.html" ;;
    quote)  start "$WS/projects/quote/index.html" ;;
    pix)    start "$WS/projects/pix/index.html" ;;
    tx)     start "$WS/projects/tx/index.html" ;;
    freedom) banner; echo "  내가 자유롭게 만든 워크스페이스 도구:"
echo "  툴킷 / 진단 / 트래커 / 보고서 / 일기 / 파일유틸 / 네트워크 / md2html / 트리맵 / 배지 / autocommit / 검색 / 워드클라우드 / 타임라인"
echo "  위젯: sns(공유QR) 일기히트맵 속도계 폴더트리맵 배지 타임라인 워드클라우드 스네이크 타이핑 갤러리 벽돌깨기 운세 커맨드센터 포모도로 devcalc regex 허미즈OS 감정리포트 게이지 호흡 분석 큐브 3D엔진 데일리 2048 틱택토 메모리 반응속도 드럼머신"
echo "  자동화: 일일보고(09:00) 주간정리(금19:00) 커밋(4h) 백업(08:00) cron" ;;
    help|-h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)       banner; banner_stats; echo ""; echo "  Try: hermes <status|tree|info|diag|watch|report|refresh|projects|backup|widget|dash|help>" ;;
esac
